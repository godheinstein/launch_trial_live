# --- Convex (live mode) ---
VITE_CONVEX_URL=
CONVEX_DEPLOYMENT=

# --- Convex action env (set in Convex dashboard → Settings → Env Vars) ---
# OPENAI_API_KEY  — required for the agent reasoning (runner action).
# ELEVENLABS_API_KEY — fallback voice provider for the verdict.
# GEMINI_API_KEY    — primary voice provider for the verdict.
# FAL_KEY           — server-only. Used by `falActions.generateAll`
#                     to render the six agent character standees in the
#                     Debate Arena. Never expose this to the browser.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
FAL_KEY=

# --- Browser-side fallbacks for demo-only mode (no Convex) ---
# WARNING: any VITE_* variable is embedded in the static JS bundle and is
# visible to anyone who opens devtools. Only set these on a demo-only
# deployment where you accept that risk. For production, leave these
# empty and use the server-side keys above (read by Convex actions).
#
# If set, the Voice Verdict button calls ElevenLabs directly from the
# browser. (Browser-side Gemini is intentionally a stub — Gemini is wired
# server-side in `convex/voiceActions.ts`.)
VITE_ELEVENLABS_API_KEY=
VITE_GEMINI_API_KEY=
