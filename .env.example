# --- Convex (live mode) ---
VITE_CONVEX_URL=
CONVEX_DEPLOYMENT=

# --- Convex action env (set in Convex dashboard → Settings → Env Vars) ---
# OPENAI_API_KEY  — required for the agent reasoning (runner action).
# ELEVENLABS_API_KEY — fallback voice provider for the verdict.
# GEMINI_API_KEY    — primary voice provider for the verdict.
# FAL_KEY           — server-only. Used by `falActions.generateAll`
#                     to render the six agent character standees in the
#                     Debate Arena. Never expose this to the browser.
OPENAI_API_KEY=
ELEVENLABS_API_KEY=
GEMINI_API_KEY=
FAL_KEY=

# --- Browser-side fallbacks for demo-only mode (no Convex) ---
# If set, the Voice Verdict button calls these providers directly from the
# browser. Gemini is currently a TODO; only ElevenLabs is wired.
VITE_ELEVENLABS_API_KEY=
VITE_GEMINI_API_KEY=
